# SentriAI — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.

# ─── Database (Neon PostgreSQL) ───────────────────────────────────────────────
# Required: Neon connection string from https://console.neon.tech
# Format: postgresql://<user>:<password>@<host>/<dbname>?sslmode=require
NEON_DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/sentriai?sslmode=require

# ─── Gemini AI (Google Generative AI) ────────────────────────────────────────
# Required: API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Node.js API Server ───────────────────────────────────────────────────────
# Port for Node.js Express server (default: 3001)
PORT=3001

# Allowed frontend origin for CORS (default: http://localhost:5173)
CORS_ORIGIN=http://localhost:5173

# ─── Python AI Worker ─────────────────────────────────────────────────────────
# Port for Python FastAPI/uvicorn server (default: 8001)
PYTHON_WORKER_PORT=8001

# Internal WebSocket URL that Node.js uses to connect to Python worker
# (default: ws://localhost:8001)
PYTHON_WS_URL=ws://localhost:8001

# Internal HTTP URL used by the Zone Editor snapshot proxy
# (default: http://localhost:8001)
PYTHON_WORKER_HTTP_URL=http://localhost:8001

# ─── Video Sources ────────────────────────────────────────────────────────────
# RTSP URL or local video file path for Gate camera (GATE-01)
# Example RTSP: rtsp://admin:password@192.168.1.100:554/stream
# Example file: ./data/samples/gate_sample.mp4
GATE_CAMERA_URL=./data/samples/gate_sample.mp4

# RTSP URL or local video file path for Area camera (BAI-KIEM)
AREA_CAMERA_URL=./data/samples/area_sample.mp4
SENTRIAI_BASE_YOLO_MODEL=yolo11n.pt
AREA_DETECTOR_KIND=yolo11
AREA_DETECTOR_MODEL=yolo11n.pt
AREA_DETECTOR_CLASSES=person,truck,car,bus,motorcycle
CUSTOM_AUGMENT_ARTIFACT=
CUSTOM_AUGMENT_VERSION_KEY=
CUSTOM_AUGMENT_FORCE_DEFAULT=false
CUSTOM_AUGMENT_CONF=0.18
CUSTOM_AUGMENT_INTERVAL=1
CUSTOM_AUGMENT_FULL_FRAME=true
CUSTOM_AUGMENT_MATCH_OVERLAP=0.18
CUSTOM_AUGMENT_FULL_FRAME_SIZE=1280
CUSTOM_AUGMENT_TILE_ENABLED=true
CUSTOM_AUGMENT_TILE_SIZE=640
CUSTOM_AUGMENT_TILE_OVERLAP=0.25
CUSTOM_AUGMENT_TILE_MAX_TILES=16
CUSTOM_AUGMENT_CROP_ENABLED=true
CUSTOM_AUGMENT_CROP_MAX_TARGETS=6
CUSTOM_AUGMENT_CROP_PADDING=0.45
CUSTOM_AUGMENT_PROMOTE_CONF=0.28
CUSTOM_AUGMENT_INSTANT_CONF=0.48
CUSTOM_AUGMENT_CONFIRM_FRAMES=2
CUSTOM_AUGMENT_CONFIRM_WINDOW=8
CUSTOM_AUGMENT_CONFIRM_WINDOW_SECONDS=2.5
CUSTOM_AUGMENT_REACH_STACKER_MIN_ASPECT=0.65
CUSTOM_AUGMENT_REACH_STACKER_NARROW_MIN_CONF=0.86
CUSTOM_AUGMENT_REACH_STACKER_MAX_AREA_RATIO=0.20
CUSTOM_AUGMENT_REACH_STACKER_CUSTOM_ONLY_COMPACT_ASPECT=1.65
CUSTOM_AUGMENT_REACH_STACKER_CUSTOM_ONLY_LARGE_AREA_RATIO=0.035
CUSTOM_AUGMENT_REACH_STACKER_CUSTOM_ONLY_COMPACT_MIN_CONF=0.80
CUSTOM_AUGMENT_REACH_STACKER_TARGET_COMPACT_ASPECT=1.65
CUSTOM_AUGMENT_REACH_STACKER_TARGET_COMPACT_MIN_CONF=0.92
CUSTOM_AUGMENT_REACH_STACKER_LONG_ASPECT=1.75
CUSTOM_AUGMENT_REACH_STACKER_LONG_MAX_AREA_RATIO=0.06
CUSTOM_AUGMENT_REACH_STACKER_LONG_MIN_CONF=0.32
CUSTOM_AUGMENT_REACH_STACKER_MAX_ASPECT=3.50
CUSTOM_AUGMENT_REACH_STACKER_MIN_HEIGHT_RATIO=0.06
TRAINING_YARD_MIN_CLASS_MAP=0.55
AREA_TRACK_INITIATION_CONFIDENCE=0.30
AREA_TRACK_CONTINUATION_CONFIDENCE=0.14
AREA_CONF_SMOOTHING=0.40
AREA_INFERENCE_SIZE=960
AREA_DETECTION_RETENTION_FRAMES=20
AREA_DETECTION_RETENTION_SECONDS=1.0
AREA_BOX_SMOOTHING=0.45
AREA_MOTION_WINDOW_FRAMES=40
AREA_STATIC_MAX_SPEED_PX_PER_FRAME=0.30
# For a YOLO-World trial:
# AREA_DETECTOR_KIND=world
# AREA_DETECTOR_MODEL=yolov8s-world.pt
# AREA_DETECTOR_CLASSES=person,forklift,mobile crane,car,truck,bus,motorcycle

# ─── Storage ──────────────────────────────────────────────────────────────────
# Local directory for saved MP4 clips (default: ./data/clips)
CLIPS_DIR=./data/clips

# Local directory for saved crop images (default: ./data/crops)
CROPS_DIR=./data/crops

# ─── Run instructions ─────────────────────────────────────────────────────────
# File này nằm ở: backend/.env.example
# Copy vào: backend/.env  (KHÔNG commit .env lên Git)
#
# 1. cp backend/.env.example backend/.env  (rồi điền NEON_DATABASE_URL, GEMINI_API_KEY)
# 2. cd backend/python-worker && pip install -r requirements.txt && python main.py
# 3. cd backend/node-api && npm install && npx prisma migrate deploy && npm run dev
# 4. cd frontend && npm install && npm run dev
# 5. Open http://localhost:5173

# SentriAI — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.

# ─── Database (Neon PostgreSQL) ───────────────────────────────────────────────
# Required: Neon connection string from https://console.neon.tech
# Format: postgresql://<user>:<password>@<host>/<dbname>?sslmode=require
NEON_DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/sentriai?sslmode=require

# ─── Gemini AI (Google Generative AI) ────────────────────────────────────────
# Required: API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Node.js API Server ───────────────────────────────────────────────────────
# Port for Node.js Express server (default: 3001)
PORT=3001

# Allowed frontend origin for CORS (default: http://localhost:5173)
CORS_ORIGIN=http://localhost:5173

# ─── Python AI Worker ─────────────────────────────────────────────────────────
# Port for Python FastAPI/uvicorn server (default: 8001)
PYTHON_WORKER_PORT=8001

# Internal WebSocket URL that Node.js uses to connect to Python worker
# (default: ws://localhost:8001)
PYTHON_WS_URL=ws://localhost:8001

# Internal HTTP URL used by the Zone Editor snapshot proxy
# (default: http://localhost:8001)
PYTHON_WORKER_HTTP_URL=http://localhost:8001

# ─── Video Sources ────────────────────────────────────────────────────────────
# RTSP URL or local video file path for Gate camera (GATE-01)
# Example RTSP: rtsp://admin:password@192.168.1.100:554/stream
# Example file, relative to repository root: backend/data/samples/gate_sample.mp4
GATE_CAMERA_URL=backend/data/samples/gate_sample.mp4

# RTSP URL or local video file path for Area camera (BAI-KIEM)
AREA_CAMERA_URL=backend/data/samples/area_sample.mp4
SENTRIAI_BASE_YOLO_MODEL=yolo11n.pt
AREA_DETECTOR_KIND=yolo11
AREA_DETECTOR_MODEL=yolo11n.pt
AREA_DETECTOR_CLASSES=person,truck,car,bus,motorcycle

# Area detection thresholds. Both values must be in [0,1] and continuation
# must not exceed initiation. 0.30/0.14 are benchmark defaults, not hard floors.
# Legacy AREA_TRACK_INITIATION_CONFIDENCE / AREA_TRACK_CONTINUATION_CONFIDENCE
# remain supported when the AREA_BASE_* names are absent.
AREA_BASE_INITIATION_CONFIDENCE=0.30
AREA_BASE_CONTINUATION_CONFIDENCE=0.14
# Example: {"base":{"person":{"initiation":0.35,"continuation":0.16}},"custom":{"reach_stacker":{"initiation":0.50,"continuation":0.28}}}
AREA_CLASS_THRESHOLDS_JSON={"base":{"person":{"initiation":0.25,"continuation":0.10},"car":{"initiation":0.30,"continuation":0.12},"truck":{"initiation":0.40,"continuation":0.16}},"custom":{"forklift":{"initiation":0.40,"continuation":0.20},"reach_stacker":{"initiation":0.05,"continuation":0.03}}}

# Migration bridge for an explicitly configured reviewed custom model when the
# database has no ACTIVE row. DB ACTIVE always wins. The worker rejects this
# bridge unless best.pt, labels.json and evaluation.json are under backend/data
# and both saved qualityGate/baseRegression are passing.
CUSTOM_AUGMENT_FORCE_DEFAULT=false
CUSTOM_AUGMENT_ARTIFACT=
CUSTOM_AUGMENT_VERSION_KEY=
CUSTOM_AUGMENT_SHA256=

# Custom detections require exactly two matching hits in the latest three
# eligible inference frames before they can promote a class or initiate a violation.
CUSTOM_CONFIRM_HITS=2
CUSTOM_CONFIRM_WINDOW=3
# Keep a confirmed custom label through eight missed custom-inference
# opportunities and smooth its box with 65% weight on the newest observation.
CUSTOM_TRACK_HOLD_OPPORTUNITIES=8
CUSTOM_TRACK_BOX_EMA_ALPHA=0.65
# Once custom class is confirmed, spatially matching base geometry may carry
# it through short base-detector gaps without adopting the base track ID.
CUSTOM_TRACK_BASE_HOLD_FRAMES=12
CUSTOM_TRACK_MAX_EDGE_STEP_RATIO=0.015

# Optional bounded inference for distant/polygon-scoped objects. Keep disabled
# until the BAI-KIEM end-to-end benchmark proves the selected ROI/FPS tradeoff.
# Config example: [{"name":"far-yard","polygon":[[0.55,0.05],[0.98,0.05],[0.98,0.55],[0.55,0.55]],"detectors":["base","custom"]}]
AREA_ROI_ENABLED=false
AREA_ROI_CONFIG_JSON=[]
AREA_ROI_INTERVAL=3
AREA_ROI_TILE_SIZE=640
AREA_ROI_TILE_OVERLAP=0.20
AREA_ROI_MAX_TILES=8

TRAINING_YARD_MIN_CLASS_MAP=0.55
AREA_INFERENCE_SIZE=896
AREA_CUSTOM_INFERENCE_SIZE=960
# Backward-compatible switch: true is translated to Ultralytics quantize=16
# (the deprecated half= keyword is never passed to inference).
AREA_INFERENCE_HALF=false
# For a YOLO-World trial:
# AREA_DETECTOR_KIND=world
# AREA_DETECTOR_MODEL=yolov8s-world.pt
# AREA_DETECTOR_CLASSES=person,forklift,mobile crane,car,truck,bus,motorcycle

# ─── Storage ──────────────────────────────────────────────────────────────────
# Local directory for saved MP4 clips (default: ./data/clips)
CLIPS_DIR=./data/clips

# On-demand Area event clips. Live sources keep compressed segments only;
# individual MP4 files are generated after the user clicks "Xem video".
AREA_ARCHIVE_RETENTION_SECONDS=7200
AREA_ARCHIVE_SEGMENT_SECONDS=2
AREA_CLIP_QUEUE_LIMIT=8
# Local camera files must stay below one of these roots.
# Use ';' between roots on Windows and ':' on macOS/Linux.
CLIP_SOURCE_ROOTS=backend/data/samples

# Local directory for saved crop images (default: ./data/crops)
CROPS_DIR=./data/crops

# ─── Run instructions ─────────────────────────────────────────────────────────
# File này nằm ở: backend/.env.example
# Copy vào: backend/.env  (KHÔNG commit .env lên Git)
#
# 1. cp backend/.env.example backend/.env  (rồi điền NEON_DATABASE_URL, GEMINI_API_KEY)
# 2. cd backend/python-worker && pip install -r requirements.txt
# 3. cd backend/node-api && npm install && npx prisma migrate deploy && npm run dev
# 4. cd frontend && npm install && npm run dev
# 5. Return to the repository root and run: npm run dev
# 6. Open http://localhost:5173

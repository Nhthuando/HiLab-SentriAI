generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("NEON_DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// registered_vehicles
// Purpose: Danh sách biển số đã đăng ký để phân biệt XE QUEN / XE LẠ (M1, M3)
// Access pattern: AP-01 (LPR matching by plate_number)
// ─────────────────────────────────────────────────────────────────────────────
model RegisteredVehicle {
  id          String   @id @default(uuid()) @db.Uuid
  plateNumber String   @unique @db.VarChar(20) @map("plate_number")
  status      String   @default("KNOWN") @db.VarChar(20)
  note        String?  @db.Text
  createdAt   DateTime @default(now()) @db.Timestamptz() @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz() @map("updated_at")

  @@map("registered_vehicles")
  // CHECK chk_registered_vehicles_status: status IN ('KNOWN', 'STRANGER')
  // Added as raw SQL in migration (Prisma limitation — no native CHECK emit for enum-like strings)
}

// ─────────────────────────────────────────────────────────────────────────────
// gate_events
// Purpose: Append-only log mọi lượt xe qua cổng IN (M1, AC-02, BR-01, BR-05)
// Access patterns: AP-02 (latest events), AP-03 (by license_plate), AP-04 (AI Q&A count)
// ─────────────────────────────────────────────────────────────────────────────
model GateEvent {
  id             String   @id @default(uuid()) @db.Uuid
  cameraId       String   @db.VarChar(50) @map("camera_id")
  lane           String   @db.VarChar(20)
  zoneName       String?  @db.VarChar(100) @map("zone_name")
  videoTimecode  String?  @db.VarChar(20) @map("video_timecode")
  licensePlate   String   @db.VarChar(20) @map("license_plate")
  status         String   @db.VarChar(20)
  confidence     Float    @db.Real
  cropPath       String?  @db.VarChar(500) @map("crop_path")
  clipPath       String?  @db.VarChar(500) @map("clip_path")
  eventTimestamp DateTime @default(now()) @db.Timestamptz() @map("timestamp")
  createdAt      DateTime @default(now()) @db.Timestamptz() @map("created_at")

  @@index([eventTimestamp(sort: Desc)], name: "idx_gate_events_timestamp_desc")
  @@index([licensePlate], name: "idx_gate_events_license_plate")
  @@index([status, eventTimestamp(sort: Desc)], name: "idx_gate_events_status_timestamp")
  @@map("gate_events")
  // CHECK chk_gate_events_lane: lane IN ('IN_1', 'IN_2')
  // CHECK chk_gate_events_status: status IN ('KNOWN', 'STRANGER')
  // CHECK chk_gate_events_confidence: confidence >= 0.0 AND confidence <= 1.0
  // Added as raw SQL in migration
}

// ─────────────────────────────────────────────────────────────────────────────
// zones
// Purpose: Cấu hình vùng giám sát đa giác + quy tắc cấm/cho phép (M2, M3)
// Access pattern: AP-05 (Python Worker poll active zones by camera)
// ─────────────────────────────────────────────────────────────────────────────
model Zone {
  id            String          @id @default(uuid()) @db.Uuid
  cameraId      String          @db.VarChar(50) @map("camera_id")
  name          String          @db.VarChar(100)
  polygonPoints Json            @map("polygon_points")
  ruleType      String          @default("PROHIBIT_SPECIFIED") @db.VarChar(50) @map("rule_type")
  targetLabels  Json            @default("[]") @map("target_labels")
  isActive      Boolean         @default(true) @map("is_active")
  createdAt     DateTime        @default(now()) @db.Timestamptz() @map("created_at")
  updatedAt     DateTime        @default(now()) @updatedAt @db.Timestamptz() @map("updated_at")

  violations ZoneViolation[]

  @@unique([cameraId, name], name: "uq_zones_camera_name")
  @@index([cameraId, isActive], name: "idx_zones_camera_active")
  @@map("zones")
  // CHECK chk_zones_rule_type: rule_type IN ('PROHIBIT_SPECIFIED', 'ALLOW_SPECIFIED')
  // Added as raw SQL in migration
}

// ─────────────────────────────────────────────────────────────────────────────
// zone_violations
// Purpose: Sự kiện vi phạm khu vực OPEN→CLOSED (M2, AC-04, BR-05, BR-06)
// Access patterns: AP-02 (latest violations), AP-06 (AI Q&A by zone), BR-06 (active tracking)
// ─────────────────────────────────────────────────────────────────────────────
model ZoneViolation {
  id              String    @id @default(uuid()) @db.Uuid
  cameraId        String    @db.VarChar(50) @map("camera_id")
  zoneId          String    @db.Uuid @map("zone_id")
  objectLabel     String    @db.VarChar(100) @map("object_label")
  status          String    @default("OPEN") @db.VarChar(20)
  enteredAt       DateTime  @default(now()) @db.Timestamptz() @map("entered_at")
  exitedAt        DateTime? @db.Timestamptz() @map("exited_at")
  durationSeconds Int?      @map("duration_seconds")
  clipPath        String?   @db.VarChar(500) @map("clip_path")
  sourceKind      String?   @db.VarChar(20) @map("source_kind")
  sourceRef       String?   @db.VarChar(1000) @map("source_ref")
  sourcePositionSeconds Float? @map("source_position_seconds")
  sourceTimestamp DateTime? @db.Timestamptz() @map("source_timestamp")
  clipStatus      String    @default("NOT_REQUESTED") @db.VarChar(20) @map("clip_status")
  clipRequestedAt DateTime? @db.Timestamptz() @map("clip_requested_at")
  clipError       String?   @db.Text @map("clip_error")
  createdAt       DateTime  @default(now()) @db.Timestamptz() @map("created_at")

  zone Zone @relation(fields: [zoneId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([enteredAt(sort: Desc)], name: "idx_zone_violations_entered_at_desc")
  @@index([zoneId, enteredAt(sort: Desc)], name: "idx_zone_violations_zone_entered")
  @@index([zoneId, status], name: "idx_zone_violations_active_tracking")
  @@map("zone_violations")
  // CHECK chk_zone_violations_status: status IN ('OPEN', 'CLOSED')
  // CHECK chk_zone_violations_duration: duration_seconds IS NULL OR duration_seconds >= 0
  // Added as raw SQL in migration
}

// ─────────────────────────────────────────────────────────────────────────────
// object_labels
// Purpose: Danh mục nhãn đối tượng tiếng Việt → YOLO class (M3, AC-06)
// ─────────────────────────────────────────────────────────────────────────────
model ObjectLabel {
  id             String        @id @default(uuid()) @db.Uuid
  vietnameseName String        @unique @db.VarChar(100) @map("vietnamese_name")
  baseClass      String        @db.VarChar(50) @map("base_class")
  createdAt      DateTime      @default(now()) @db.Timestamptz() @map("created_at")
  updatedAt      DateTime      @default(now()) @updatedAt @db.Timestamptz() @map("updated_at")

  samples LabelSample[]

  @@map("object_labels")
}

// ─────────────────────────────────────────────────────────────────────────────
// label_samples
// Purpose: Mẫu ảnh + bbox đã gán nhãn (M3, success metrics ≥ 20 mẫu/nhãn)
// Access pattern: AP-07 (load samples by label)
// ─────────────────────────────────────────────────────────────────────────────
model LabelSample {
  id               String      @id @default(uuid()) @db.Uuid
  labelId          String      @db.Uuid @map("label_id")
  imagePath        String      @db.VarChar(500) @map("image_path")
  mediaRef         String?     @db.VarChar(500) @map("media_ref")
  mediaKind        String?     @db.VarChar(10) @map("media_kind")
  frameTimestampMs Int?        @map("frame_timestamp_ms")
  bbox             Json
  createdAt        DateTime    @default(now()) @db.Timestamptz() @map("created_at")

  label ObjectLabel @relation(fields: [labelId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([labelId], name: "idx_label_samples_label_id")
  @@map("label_samples")
}

model TrainingDataset {
  id           String        @id @default(uuid()) @db.Uuid
  manifestPath String        @db.VarChar(500) @map("manifest_path")
  contentHash  String        @unique @db.VarChar(64) @map("content_hash")
  sampleCount  Int           @map("sample_count")
  sourceCount  Int           @map("source_count")
  createdAt    DateTime      @default(now()) @db.Timestamptz() @map("created_at")
  jobs         TrainingJob[]
  @@map("training_datasets")
}

model TrainingJob {
  id           String         @id @default(uuid()) @db.Uuid
  datasetId    String         @db.Uuid @map("dataset_id")
  status       String         @default("QUEUED") @db.VarChar(20)
  baseModel    String         @db.VarChar(100) @map("base_model")
  currentEpoch Int            @default(0) @map("current_epoch")
  totalEpochs  Int            @map("total_epochs")
  pauseReason  String?        @db.VarChar(50) @map("pause_reason")
  failureReason String?       @db.Text @map("failure_reason")
  requestedAt  DateTime       @default(now()) @db.Timestamptz() @map("requested_at")
  startedAt    DateTime?      @db.Timestamptz() @map("started_at")
  completedAt  DateTime?      @db.Timestamptz() @map("completed_at")
  dataset      TrainingDataset @relation(fields: [datasetId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  modelVersion ModelVersion?
  @@index([requestedAt(sort: Desc)], name: "idx_training_jobs_requested_at_desc")
  @@index([status, requestedAt(sort: Desc)], name: "idx_training_jobs_status_requested_at")
  @@map("training_jobs")
}

model ModelVersion {
  id                String       @id @default(uuid()) @db.Uuid
  trainingJobId     String       @unique @db.Uuid @map("training_job_id")
  versionKey        String       @unique @db.VarChar(100) @map("version_key")
  baseModel         String       @db.VarChar(100) @map("base_model")
  artifactPath      String       @db.VarChar(500) @map("artifact_path")
  artifactSha256    String       @db.VarChar(64) @map("artifact_sha256")
  status            String       @default("CANDIDATE") @db.VarChar(20)
  evaluationMetrics Json?        @map("evaluation_metrics")
  evaluatedAt       DateTime?    @db.Timestamptz() @map("evaluated_at")
  activatedAt       DateTime?    @db.Timestamptz() @map("activated_at")
  createdAt         DateTime     @default(now()) @db.Timestamptz() @map("created_at")
  trainingJob       TrainingJob  @relation(fields: [trainingJobId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  @@index([createdAt(sort: Desc)], name: "idx_model_versions_created_at_desc")
  @@map("model_versions")
}

// ─────────────────────────────────────────────────────────────────────────────
// chat_messages
// Purpose: Lịch sử hỏi đáp AI Q&A append-only, persistent qua sessions (M4)
// Access pattern: chronological load via idx_chat_messages_created_at_asc
// ─────────────────────────────────────────────────────────────────────────────
model ChatMessage {
  id            String   @id @default(uuid()) @db.Uuid
  role          String   @db.VarChar(20)
  content       String   @db.Text
  clipReference String?  @db.VarChar(500) @map("clip_reference")
  createdAt     DateTime @default(now()) @db.Timestamptz() @map("created_at")

  @@index([createdAt(sort: Asc)], name: "idx_chat_messages_created_at_asc")
  @@map("chat_messages")
  // CHECK chk_chat_messages_role: role IN ('user', 'assistant')
  // Added as raw SQL in migration
}
